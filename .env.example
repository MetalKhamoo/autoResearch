# AutoResearch Environment Variables
# Copy this file to .env and fill in your values.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Anthropic (default provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenAI (for future provider swap)
# OPENAI_API_KEY=your_openai_api_key_here

# Active provider: "anthropic" | "openai"
LLM_PROVIDER=anthropic

# Model name passed to the provider
LLM_MODEL=claude-opus-4-5

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default). Switch to PostgreSQL DSN for production:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/autoresearch
DATABASE_URL=sqlite+aiosqlite:///./autoresearch.db

# ── Vector Store ──────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=autoresearch_docs

# ── Web Search ────────────────────────────────────────────────────────────────
# "duckduckgo" (no key required) or "serpapi"
SEARCH_PROVIDER=duckduckgo
# SERPAPI_KEY=your_serpapi_key_here

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_TIMEZONE=UTC

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Research Config ───────────────────────────────────────────────────────────
# Max web pages to scrape per research job
MAX_SEARCH_RESULTS=10
# Max tokens to pass to summariser from RAG
RAG_TOP_K=5
